@model IEnumerable<PlataformaCreditos.Models.SolicitudCredito>

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<h1>Mis Solicitudes de Crédito</h1>

<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="0" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente)">Pendiente</option>
                <option value="1" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado)">Aprobado</option>
                <option value="2" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado)">Rechazado</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Monto Mínimo</label>
            <input type="number" step="0.01" name="montoMinimo" class="form-control" value="@ViewBag.MontoMinimo" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Monto Máximo</label>
            <input type="number" step="0.01" name="montoMaximo" class="form-control" value="@ViewBag.MontoMaximo" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha Inicio</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha Fin</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Monto Solicitado</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.MontoSolicitado.ToString("C")</td>
                <td>@item.FechaSolicitud.ToShortDateString()</td>
                <td>
                    <span class="badge @(item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado ? "bg-success" : (item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark"))">
                        @item.Estado
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
