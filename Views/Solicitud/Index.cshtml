@model IEnumerable<PlataformaCreditos.Models.SolicitudCredito>

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<h1>Mis Solicitudes de Crédito</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-success">Crear Nueva Solicitud</a>
</p>

<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="0" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente)">Pendiente</option>
                <option value="1" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado)">Aprobado</option>
                <option value="2" selected="@(ViewBag.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado)">Rechazado</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Monto Mínimo</label>
            <input type="number" step="0.01" name="montoMinimo" class="form-control" value="@ViewBag.MontoMinimo" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Monto Máximo</label>
            <input type="number" step="0.01" name="montoMaximo" class="form-control" value="@ViewBag.MontoMaximo" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha Inicio</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha Fin</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>
}

<div class="mb-3">
    <span id="signalr-status" class="badge bg-secondary">Conectando...</span>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Monto Solicitado</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row-@item.Id">
                <td>@item.Id</td>
                <td>@item.MontoSolicitado.ToString("C")</td>
                <td>@item.FechaSolicitud.ToShortDateString()</td>
                <td>
                    <span id="badge-@item.Id" class="badge @(item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado ? "bg-success" : (item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark"))">
                        @item.Estado
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalle</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/solicitudes")
            .withAutomaticReconnect()
            .build();

        connection.on("SolicitudEstadoActualizado", function (data) {
            alert("¡Tu solicitud #" + data.solicitudId + " ahora está en estado " + data.estado + "!");
            
            const badge = document.getElementById("badge-" + data.solicitudId);
            if (badge) {
                badge.innerText = data.estado;
                badge.className = "badge " + (data.estado === "Aprobado" ? "bg-success" : "bg-danger");
            }
        });

        connection.start().then(function () {
            document.getElementById("signalr-status").innerText = "Conectado";
            document.getElementById("signalr-status").className = "badge bg-success";
        }).catch(function (err) {
            document.getElementById("signalr-status").innerText = "Desconectado";
            document.getElementById("signalr-status").className = "badge bg-danger";
            return console.error(err.toString());
        });
    </script>
}
