@model decimal

@{
    ViewData["Title"] = "Crear Solicitud";
}

<h1>Nueva Solicitud de Crédito</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label for="montoSolicitado" class="control-label">Monto Solicitado</label>
                <input type="number" step="0.01" id="montoSolicitado" name="montoSolicitado" class="form-control" value="@Model" required />
                <span asp-validation-for="@Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Crear Solicitud" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
