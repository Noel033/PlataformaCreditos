@model decimal

@{
    ViewData["Title"] = "Crear Solicitud";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-primary text-white text-center rounded-top">
                <h4 class="mb-0">Nueva Solicitud de Crédito</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-floating mb-4">
                        <input type="number" step="0.01" id="montoSolicitado" name="montoSolicitado" class="form-control" value="@Model" required placeholder="1000.00" />
                        <label for="montoSolicitado" class="ms-2">Monto Solicitado ($)</label>
                        <span asp-validation-for="@Model" class="text-danger ms-3"></span>
                        <div class="form-text mt-2 ms-2">El monto solicitado será evaluado de acuerdo a tus ingresos mensuales.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Crear Solicitud</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill shadow-sm mt-2">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
