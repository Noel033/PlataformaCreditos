@model PlataformaCreditos.Models.SolicitudCredito

@{
    ViewData["Title"] = "Detalle de Solicitud";
}

<h1>Detalle de la Solicitud #@Model.Id</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Monto Solicitado</dt>
        <dd class="col-sm-9">@Model.MontoSolicitado.ToString("C")</dd>

        <dt class="col-sm-3">Fecha de Solicitud</dt>
        <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado ? "bg-success" : (Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark"))">
                @Model.Estado
            </span>
        </dd>

        @if (Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado)
        {
            <dt class="col-sm-3">Motivo de Rechazo</dt>
            <dd class="col-sm-9">@Model.MotivoRechazo</dd>
        }

        <dt class="col-sm-3">Cliente ID</dt>
        <dd class="col-sm-9">@Model.ClienteId</dd>

        <dt class="col-sm-3">Ingresos Mensuales del Cliente</dt>
        <dd class="col-sm-9">@Model.Cliente?.IngresosMensuales.ToString("C")</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Volver al Catálogo</a>
</div>
