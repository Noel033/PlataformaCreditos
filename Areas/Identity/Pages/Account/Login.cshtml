@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white text-center rounded-top">
                <h3 class="font-weight-light my-2">@ViewData["Title"]</h3>
            </div>
            <div class="card-body p-4">
                <section>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-pill px-4" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label ms-2">Correo Electrónico</label>
                            <span asp-validation-for="Input.Email" class="text-danger ms-3"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-pill px-4" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label ms-2">Contraseña</label>
                            <span asp-validation-for="Input.Password" class="text-danger ms-3"></span>
                        </div>
                        <div class="form-check mb-3 ms-2">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label">
                                Recordarme
                            </label>
                        </div>
                        <div class="d-grid gap-2 mt-4 mb-0">
                            <button id="login-submit" type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Iniciar Sesión</button>
                        </div>
                    </form>
                </section>
            </div>
            <div class="card-footer text-center py-3 bg-light rounded-bottom">
                <div class="small">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">¿No tienes cuenta? ¡Regístrate aquí!</a>
                </div>
                <div class="small mt-2">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none text-muted">¿Olvidaste tu contraseña?</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
