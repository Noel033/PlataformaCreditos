@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-success text-white text-center rounded-top">
                <h3 class="font-weight-light my-2">@ViewData["Title"]</h3>
            </div>
            <div class="card-body p-4">
                <section>
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-pill px-4" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label ms-2">Correo Electrónico</label>
                            <span asp-validation-for="Input.Email" class="text-danger ms-3"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-pill px-4" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label ms-2">Contraseña</label>
                            <span asp-validation-for="Input.Password" class="text-danger ms-3"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-pill px-4" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword" class="form-label ms-2">Confirmar Contraseña</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger ms-3"></span>
                        </div>
                        <div class="d-grid gap-2 mt-4 mb-0">
                            <button id="registerSubmit" type="submit" class="btn btn-success btn-lg rounded-pill shadow-sm">Crear Cuenta</button>
                        </div>
                    </form>
                </section>
            </div>
            <div class="card-footer text-center py-3 bg-light rounded-bottom">
                <div class="small">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">¿Ya tienes una cuenta? Inicia sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
